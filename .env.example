# NO environment variable is required: the app starts and works with none set.
# Everything below is OPTIONAL tuning (the values shown are the defaults). Never commit a real .env file.
MAX_COMPETITORS=25
REQUEST_TIMEOUT_SECONDS=8
MAX_RESPONSE_BYTES=2000000
CHECK_CONCURRENCY=4
MAX_ARTICLES_PER_COMPETITOR=100
# Local testing only: allow checking http://localhost / private addresses (keep false on a public deployment)
ALLOW_PRIVATE_URLS=false
